# 讯飞星火凭证配置
# 使用方法：复制本文件为 .env，填入你自己的凭证。
# .env 已在 .gitignore 中，不会被提交到仓库。
# 凭证获取：https://console.xfyun.cn/ → 创建应用 → 星火认知大模型 → 查看 APPID / APIKey / APISecret

XUNFEI_APP_ID=your_app_id
XUNFEI_API_KEY=your_api_key
XUNFEI_API_SECRET=your_api_secret

# 可选：模型版本，取值 x2 / lite / pro / max / ultra，默认 x2
# 注意各版本独立计量 token，必须先在控制台领取对应版本的额度
# 没有 X2 余量时改用 lite（免费额度，需在控制台 0 元领取）
SPARK_MODEL=x2
